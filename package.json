{
  "name": "dsh-lang-switch",
  "version": "0.1.0",
  "private": true,
  "description": "思考与响应语言切换：分别设置思考过程与回复所用的语言",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "icon": "icon.svg",
  "scripts": {
    "pack": "npm pack --ignore-scripts"
  }
}
